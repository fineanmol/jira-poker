modules:
  # jira:issueContext — ALWAYS VISIBLE in the right sidebar as a collapsible section.
  # Users expand it by clicking the label. No extra button-hunting required.
  jira:issueContext:
    - key: estimation-context
      title: Agile Effort Estimation
      label: 🃏 Estimate Story Points
      icon: https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/suit-spade-fill.svg
      resource: main
      resolver:
        function: resolver

  # jira:issuePanel — full-width panel above Activity, activated by clicking
  # the icon button that appears near the top of the issue view.
  jira:issuePanel:
    - key: estimation-panel
      title: Agile Effort Estimation
      icon: https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/icons/suit-spade-fill.svg
      resource: main
      resolver:
        function: resolver

  function:
    - key: resolver
      handler: resolvers/index.handler

resources:
  - key: main
    path: static/frontend/dist
    tunnel:
      port: 5173

app:
  id: ari:cloud:ecosystem::app/4f4ab9d3-1cfb-4ebf-b265-987811a57b61
  runtime:
    name: nodejs22.x
permissions:
  scopes:
    - read:jira-work
    - write:jira-work
    - read:jira-user
    - storage:app
